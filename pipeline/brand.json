{
  "platform": "instagram",
  "format": "vertical",

  "transcription": {
    "provider": "whisper",
    "model": "base",
    "language": "fr"
  },

  "subtitles": {
    "font": "Arial Black",
    "font_size": 62,
    "color_primary": "#111111",
    "color_accent": "#E02020",
    "words_per_line": 4
  },

  "style": "light",

  "bg_color": "#ffffff",

  "derush": {
    "silence_threshold_db": -35,
    "min_silence_duration_sec": 0.6,
    "retake_similarity": 0.75,
    "retake_window_words": 6
  },

  "audio": {
    "target_lufs": -14
  }
}
